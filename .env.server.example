# Express / Google OAuth (keep this file server-side; never prefix secrets with VITE_)
NODE_ENV=production
PORT=3000
APP_URL=https://clickagency.online
FRONTEND_ORIGIN=https://clickagency.online
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://clickagency.online/auth/google/callback
